# NightRun model manifest — the single source of truth for the installer's
# model catalog. Line format: `model.<id>.<key> = <value>` (parsed line by
# line; this file is data, never sourced as shell). Blank lines and `#`
# comments are ignored. Bump `manifest.version` on format changes.
#
# sha256 values were computed from local artifacts AND cross-checked against
# Hugging Face's X-Linked-ETag (the LFS object hash) on 2026-07-07.
# `revision` pins the repo commit the artifact was fetched from; downloads
# resolve `.../resolve/<revision>/<file>` so a moved branch cannot silently
# change what users get.

manifest.version = 1

model.llama-1b.name           = Llama 3.2 1B Instruct
model.llama-1b.enabled        = yes
